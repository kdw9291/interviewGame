# Gemini 무료 API 키 3~5개를 콤마로 구분해 등록 (라운드로빈 로테이션)
# 발급: https://aistudio.google.com/app/apikey (신용카드 미연동 상태 유지)
GEMINI_API_KEYS=key1,key2,key3

# Supabase 프로젝트 (Free Tier, 신용카드 미등록)
# 둘 중 하나라도 비어 있으면 캐시/폴백 아카이브(answer_cache)와
# 박제·명예의 전당(interview_results) 기능이 조용히 비활성화된다.
# 사용 전 명세서 6번 DDL(SQL)을 Supabase SQL 에디터에서 먼저 실행해야 한다.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# Google AdSense 발행자 ID (심사 통과 후 발급). 비어 있으면 광고 자리에 플레이스홀더만 표시된다.
NEXT_PUBLIC_ADSENSE_CLIENT=

# 배포 도메인 (OpenGraph 이미지 절대경로 계산용). 예: https://your-app.vercel.app
NEXT_PUBLIC_SITE_URL=
